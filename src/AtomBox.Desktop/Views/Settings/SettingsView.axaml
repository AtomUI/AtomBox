<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:loc="using:AtomBox.Desktop.Localization"
             xmlns:pages="using:AtomBox.Desktop.ViewModels.Pages"
             x:Class="AtomBox.Desktop.Views.Settings.SettingsView"
             x:DataType="pages:SettingsViewModel">
    <UserControl.Styles>
        <Style Selector="Grid.setting-row">
            <Setter Property="ColumnSpacing" Value="28" />
            <Setter Property="MinHeight" Value="50" />
        </Style>
        <Style Selector="TextBlock.setting-label">
            <Setter Property="Foreground" Value="{StaticResource AtomBoxPrimaryTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.setting-description">
            <Setter Property="Foreground" Value="{StaticResource AtomBoxTertiaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="56,*">
        <Border Grid.Row="0"
                Classes="app-page-header">
            <DockPanel LastChildFill="False"
                       VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left"
                           Classes="app-page-title"
                           Text="{Binding Title}"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Grid Grid.Row="1"
              Classes="app-page-content"
              RowDefinitions="*,Auto">
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource AtomBoxBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="22,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="14"
                                HorizontalAlignment="Stretch"
                                MaxWidth="900">
                    <Grid Classes="setting-row"
                          ColumnDefinitions="260,*">
                        <StackPanel Grid.Column="0"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="setting-label"
                                       Text="{loc:Loc Settings.InterfaceLanguage}" />
                            <TextBlock Classes="setting-description"
                                       Text="{loc:Loc Settings.InterfaceLanguageDescription}" />
                        </StackPanel>
                        <Grid Grid.Column="1"
                              MinHeight="32"
                              VerticalAlignment="Center">
                            <atom:ComboBox SelectedIndex="{Binding LanguageSelectedIndex}"
                                           IsEnabled="{Binding IsLanguageSelectionEnabled}"
                                           Width="220">
                                <atom:ComboBoxItem Content="{loc:Loc Settings.FollowSystem}" />
                                <atom:ComboBoxItem Content="{loc:Loc Settings.SimplifiedChinese}" />
                                <atom:ComboBoxItem Content="{loc:Loc Settings.English}" />
                            </atom:ComboBox>
                        </Grid>
                    </Grid>

                    <atom:Separator SizeType="Small" />

                    <Grid Classes="setting-row"
                          ColumnDefinitions="260,*">
                        <StackPanel Grid.Column="0"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="setting-label"
                                       Text="{loc:Loc Settings.StartupPage}" />
                            <TextBlock Classes="setting-description"
                                       Text="{loc:Loc Settings.StartupPageDescription}" />
                        </StackPanel>
                        <Grid Grid.Column="1"
                              MinHeight="32"
                              VerticalAlignment="Center">
                        <atom:ComboBox SelectedIndex="{Binding StartupPageSelectedIndex}"
                                       Width="220">
                            <atom:ComboBoxItem Content="{loc:Loc Shell.Home}" />
                            <atom:ComboBoxItem Content="{loc:Loc Shell.RemoteStorage}" />
                            <atom:ComboBoxItem Content="{loc:Loc Shell.TransferQueue}" />
                            <atom:ComboBoxItem Content="{loc:Loc Shell.AccountManagement}" />
                        </atom:ComboBox>
                        </Grid>
                    </Grid>

                    <atom:Separator SizeType="Small" />

                    <Grid Classes="setting-row"
                          ColumnDefinitions="260,*">
                        <StackPanel Grid.Column="0"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="setting-label"
                                       Text="{loc:Loc Settings.CloseWindow}" />
                            <TextBlock Classes="setting-description"
                                       Text="{loc:Loc Settings.CloseWindowDescription}" />
                        </StackPanel>
                        <Grid Grid.Column="1"
                              MinHeight="32"
                              VerticalAlignment="Center">
                            <atom:ComboBox SelectedIndex="{Binding CloseBehaviorSelectedIndex}"
                                           Width="220">
                                <atom:ComboBoxItem Content="{loc:Loc Settings.CloseApplication}" />
                                <atom:ComboBoxItem Content="{loc:Loc Settings.MinimizeApplication}" />
                            </atom:ComboBox>
                        </Grid>
                    </Grid>

                    <atom:Separator SizeType="Small" />

                    <Grid Classes="setting-row"
                          ColumnDefinitions="260,*">
                        <StackPanel Grid.Column="0"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="setting-label"
                                       Text="{loc:Loc Settings.DefaultDownloadDirectory}" />
                            <TextBlock Classes="setting-description"
                                       Text="{loc:Loc Settings.DefaultDownloadDirectoryDescription}" />
                        </StackPanel>
                        <Grid Grid.Column="1"
                              ColumnDefinitions="360,Auto"
                              ColumnSpacing="8"
                              MinHeight="32"
                              VerticalAlignment="Center">
                            <atom:LineEdit Grid.Column="0"
                                           Text="{Binding DefaultDownloadDirectory}"
                                           IsReadOnly="True" />
                            <atom:Button Grid.Column="1"
                                         Content="{loc:Loc Common.Modify}"
                                         Command="{Binding ChooseDownloadDirectoryCommand}" />
                        </Grid>
                    </Grid>

                    <atom:Separator SizeType="Small" />

                    <Grid Classes="setting-row"
                          ColumnDefinitions="260,*">
                        <StackPanel Grid.Column="0"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="setting-label"
                                       Text="{loc:Loc Settings.MaxConcurrency}" />
                            <TextBlock Classes="setting-description"
                                       Text="{loc:Loc Settings.MaxConcurrencyDescription}" />
                        </StackPanel>
                        <Grid Grid.Column="1"
                              MinHeight="32"
                              VerticalAlignment="Center">
                            <atom:NumericUpDown Minimum="1"
                                                Maximum="16"
                                                Increment="1"
                                                FormatString="0"
                                                Value="{Binding DefaultConcurrency}"
                                                Width="140"
                                                HorizontalAlignment="Left" />
                        </Grid>
                    </Grid>

                    <atom:Separator SizeType="Small" />

                    <Grid Classes="setting-row"
                          ColumnDefinitions="260,*">
                        <StackPanel Grid.Column="0"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="setting-label"
                                       Text="{loc:Loc Settings.FingerprintIndex}" />
                            <TextBlock Classes="setting-description"
                                       Text="{loc:Loc Settings.FingerprintIndexDescription}" />
                        </StackPanel>
                        <Grid Grid.Column="1"
                              MinHeight="32"
                              VerticalAlignment="Center">
                            <atom:ToggleSwitch IsChecked="{Binding EnableUploadFingerprintIndex, Mode=TwoWay}"
                                               HorizontalAlignment="Left" />
                        </Grid>
                    </Grid>

                    <!--
                    缓存能力目前只有目录和 Infrastructure 占位类，尚未接入真实业务链路。
                    后续实现 MetadataCache / ThumbnailCache / 清理缓存用例后，可恢复缓存相关表单项。
                    -->

                    <atom:Separator SizeType="Small" />

                    <Grid Classes="setting-row"
                          ColumnDefinitions="260,*">
                        <StackPanel Grid.Column="0"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="setting-label"
                                       Text="{loc:Loc Settings.ConfigurationDirectory}" />
                            <TextBlock Classes="setting-description"
                                       Text="{loc:Loc Settings.ConfigurationDirectoryDescription}" />
                        </StackPanel>
                        <Grid Grid.Column="1"
                              MinHeight="32"
                              VerticalAlignment="Center">
                            <atom:Button Content="{loc:Loc Common.Open}"
                                         Command="{Binding OpenConfigurationDirectoryCommand}"
                                         HorizontalAlignment="Left" />
                        </Grid>
                    </Grid>

                    <atom:Separator SizeType="Small" />

                    <Grid Classes="setting-row"
                          ColumnDefinitions="260,*">
                        <StackPanel Grid.Column="0"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="setting-label"
                                       Text="{loc:Loc Settings.LogDirectory}" />
                            <TextBlock Classes="setting-description"
                                       Text="{loc:Loc Settings.LogDirectoryDescription}" />
                        </StackPanel>
                        <Grid Grid.Column="1"
                              MinHeight="32"
                              VerticalAlignment="Center">
                            <atom:Button Content="{loc:Loc Common.Open}"
                                         Command="{Binding OpenLogDirectoryCommand}"
                                         HorizontalAlignment="Left" />
                        </Grid>
                    </Grid>

                    <atom:Separator SizeType="Small" />

                    <Grid Classes="setting-row"
                          ColumnDefinitions="260,*">
                        <StackPanel Grid.Column="0"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="setting-label"
                                       Text="{loc:Loc Settings.StateDirectory}" />
                            <TextBlock Classes="setting-description"
                                       Text="{loc:Loc Settings.StateDirectoryDescription}" />
                        </StackPanel>
                        <Grid Grid.Column="1"
                              MinHeight="32"
                              VerticalAlignment="Center">
                            <atom:Button Content="{loc:Loc Common.Open}"
                                         Command="{Binding OpenStateDirectoryCommand}"
                                         HorizontalAlignment="Left" />
                        </Grid>
                    </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Grid Grid.Row="1"
                  Margin="0,12,0,0"
                  ColumnDefinitions="*,Auto">
                <atom:Button Grid.Column="0"
                             Content="{loc:Loc Common.ViewDetails}"
                             Command="{Binding ShowErrorDetailsCommand}"
                             IsVisible="{Binding HasErrorDetails}"
                             HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                    <atom:Button Content="{loc:Loc Common.Reset}"
                                 Command="{Binding ResetCommand}" />
                    <atom:Button Content="{loc:Loc Common.Save}"
                                 ButtonType="Primary"
                                 Command="{Binding SaveCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
